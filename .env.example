# Public site URL (used for canonical URLs, sitemap, OG)
NEXT_PUBLIC_SITE_URL=https://nexarctechnologies.com

# Supabase (Project Settings > API). Service role key is server-only; never expose it.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Resend (resend.com). Verify nexarctechnologies.com in Resend first.
RESEND_API_KEY=
LEADS_FROM_EMAIL="NexArc Website <hello@nexarctechnologies.com>"
LEADS_TO_EMAIL=sriakash@nexarctechnologies.com

# Cloudflare Turnstile (optional in dev; recommended in production)
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Cal.com booking link (optional), e.g. https://cal.com/nexarc/intro
NEXT_PUBLIC_CAL_LINK=
